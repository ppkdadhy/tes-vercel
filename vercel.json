{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.7.3",
            "config": {
                "includeFiles": [
                    "api/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(css|js|images|fonts|scss)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/project-crud/assets/(.*)",
            "dest": "/api/project-crud/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}